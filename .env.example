# CodeRoot-MCP configuration. Copy to .env and fill in real values.
# Both CODEROOT_API_URL and CODEROOT_API_TOKEN are required — the service
# refuses to start without them (fail closed).

# Base URL of the CodeRoot API this MCP server reads through, no trailing slash,
# no /v1 prefix (CodeRoot does not version its routes).
CODEROOT_API_URL=http://localhost:8080

# Bearer token sent as `Authorization: Bearer <token>` on every request to CodeRoot.
CODEROOT_API_TOKEN=

# Per-request timeout, in seconds, for calls to CodeRoot.
REQUEST_TIMEOUT_S=30

# Which MCP transport this process serves: "stdio" (default -- a local
# client spawns this process and talks JSON-RPC over stdin/stdout) or
# "streamable-http" (another service dials this process over the network).
MCP_TRANSPORT=stdio

# Bind address/port, used only when MCP_TRANSPORT=streamable-http.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000

# --- inbound auth (streamable-http only) ---
# When MCP_TRANSPORT=streamable-http, this process opens a network listener
# and the service refuses to start unless ONE of the two settings below is
# present. stdio has no listener (a local client spawns this as a
# subprocess), so neither applies there.

# Bearer token every streamable-http caller must send as
# `Authorization: Bearer <token>`. This is the SAME value the sibling
# Assessor service sends as its own CODEROOT_MCP_TOKEN
# (assessor/config.py's `coderoot_mcp_token`) -- one shared secret, named
# after the service it grants access to, set on both ends.
CODEROOT_MCP_TOKEN=

# Explicit opt-out: set to true to serve streamable-http with no inbound
# auth at all. Only for local/eval deployments where the network path to
# this port is already otherwise controlled (e.g. loopback-only publish).
# Leaving this false with CODEROOT_MCP_TOKEN unset is what makes the process
# refuse to start, by design.
CODEROOT_MCP_ALLOW_ANONYMOUS=false
